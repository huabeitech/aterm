    "@xterm/addon-web-links": "0.13.0-beta.331",
    "@xterm/addon-webgl": "0.20.0-beta.330",
    "@xterm/xterm": "6.1.0-beta.337",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
