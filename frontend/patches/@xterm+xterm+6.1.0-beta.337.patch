index 0000000000000000000000000000000000000000..376f3ec072a2e0b7d38a647ec70244d6dc1d1285
--- /dev/null
+++ b/node_modules/@xterm/xterm/lib/ime-compat.cjs
@@ -0,0 +1,76 @@
+/*
+ * macOS IME punctuation compatibility for @xterm/xterm 6.1.0-beta.337.
+ *
+ * Upstream #4486 / #6294: keydown can contain ASCII while keypress.charCode
+ * contains the IME's committed punctuation. Defer text-producing punctuation
+ * to keypress, retaining xterm's composition handling, dedupe and shortcuts.
+ * Unlike #6294, the enhanced path feeds committed text back into xterm's own
+ * keyboard encoder, so Kitty modifiers, event types and associated text survive.
+ * No application/process detection and no application-specific key mappings.
+ * Remove this version-pinned adapter once upstream supports both paths.
+ */
+const installed = Symbol('macIMECompatibility');
+
+function committedEvent(event, physical, text) {
+  const overrides = { key: text, keyCode: physical.keyCode, code: physical.code,
+    repeat: physical.repeat };
+  return new Proxy(event, {
+    get(target, property) {
+      if (Object.hasOwn(overrides, property)) return overrides[property];
+      const value = Reflect.get(target, property, target);
+      return typeof value === 'function' ? value.bind(target) : value;
+    }
+  });
+}
+
+exports.install = function install(core) {
+  if (!core.browser.isMac || core[installed]) return;
+  core[installed] = true;
+  const keyboard = core._keyboardService;
+  const evaluate = keyboard.evaluateKeyDown;
+  const keyDown = core._keyDown;
+  const keyPress = core._keyPress;
+  const keyUp = core._keyUp;
+  const releases = new Map();
+  let pending;
+
+  keyboard.evaluateKeyDown = function(event) {
+    const codepoint = event.key.length === 1 ? event.key.codePointAt(0) : -1;
+    // Same printable punctuation/digit range as #6294, plus full-width space.
+    // Composition has already been delegated before this encoder is called.
+    const textKey = (codepoint >= 32 && codepoint <= 64) ||
+      (codepoint >= 91 && codepoint <= 96) || (codepoint >= 123 && codepoint <= 126);
+    if (event.type === 'keydown' && textKey && !event.isComposing &&
+        !event.ctrlKey && !event.altKey && !event.metaKey && !this.useWin32InputMode) {
+      pending = event;
+      // Host bubbling shortcuts must not suppress the eventual IME keypress.
+      event.stopPropagation();
+      return { type: 0, cancel: false, key: undefined };
+    }
+    return evaluate.call(this, event);
+  };
+
+  core._keyPress = function(event) {
+    const physical = pending;
+    pending = undefined;
+    if (!physical || !event.charCode || !keyboard.useKitty) {
+      return keyPress.call(this, event);
+    }
+    const text = String.fromCodePoint(event.charCode);
+    releases.set(physical.code, { physical, text });
+    // Running the original keydown with the keypress event reuses the complete
+    // upstream encoder/delivery path. Its event type prevents another deferral.
+    const result = keyDown.call(this, committedEvent(event, physical, text));
+    this._keyPressHandled = true;
+    return result;
+  };
+
+  core._keyUp = function(event) {
+    if (pending && pending.code === event.code) pending = undefined;
+    const committed = releases.get(event.code);
+    releases.delete(event.code);
+    return keyUp.call(this, committed
+      ? committedEvent(event, committed.physical, committed.text)
+      : event);
+  };
+};
diff --git a/node_modules/@xterm/xterm/lib/xterm-ime.js b/node_modules/@xterm/xterm/lib/xterm-ime.js
