--- /dev/null
+++ b/node_modules/@xterm/xterm/lib/xterm-ime.js
@@ -0,0 +1,8 @@
+const { Terminal: UpstreamTerminal } = require('./xterm.js');
+const { install } = require('./ime-compat.cjs');
+exports.Terminal = class Terminal extends UpstreamTerminal {
+  open(parent) {
+    super.open(parent);
+    install(this._core);
+  }
+};
